# Copia este archivo como .env para correr localmente (Railway inyecta estas
# mismas variables directamente, no necesita el archivo .env).

PORT=3000

# Correo del dueno del negocio -- recibe las notificaciones internas de venta.
ESTEBAN_EMAIL=esteban.serna.garcia@gmail.com

# Claude (simulador de IA del sitio)
ANTHROPIC_API_KEY=

# Mercado Pago (Access Token de PRODUCCION -- nunca el Public Key aqui)
MP_ACCESS_TOKEN=

# URL publica de este mismo backend en Railway (para notification_url de MP)
PUBLIC_BASE_URL=https://esteban-ia-backend-production.up.railway.app

# Google Calendar -- cuenta de servicio (JSON completo, en una sola linea)
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=
GOOGLE_CALENDAR_ID=primary

# Resend (correo transaccional, para el correo de bienvenida al cliente)
RESEND_API_KEY=
RESEND_FROM=Esteban IA <onboarding@resend.dev>

# WhatsApp Business (Meta Cloud API) -- reutiliza las mismas credenciales del
# proyecto whatsapp-assistant
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Origen permitido para CORS (el dominio del sitio)
ALLOWED_ORIGIN=https://esteban-serna.com
